# Obtain it on your LOCAL machine after running:
#   claude mcp add robinhood-trading --transport http https://agent.robinhood.com/mcp/trading
#   /mcp   -> robinhood-trading -> authenticate
# Only needed for live trading and for scripts/discover_mcp_tools.py.
ROBINHOOD_MCP_TOKEN=
